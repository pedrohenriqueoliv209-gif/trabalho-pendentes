int potenciometro = A0;
void setup()
{
 // define o pino 2 como entrada (botão)
 pinMode (2, INPUT); 
  // define o pino 11 como saida (LED) 
 pinMode (11, OUTPUT);
 
}
void loop ()
{
 // verificação se o pino 2 está recebendo um sinal high 
  
  if (digitalRead(2))
  {
   for (int i=0; i<=2; i++)
   { 	
   digitalWrite(11, HIGH);
     delay(1000);
   digitalWrite(11, LOW);
     delay(1000);
     
 }
  
  }
  else
  {
    //Ler o valor analogico do potenciometro 
  //Que varia de (0 a 1023)
  int potenciometroValor = analogRead(potenciometro);
  //Mapear a faixa de valores do potenciometro
  //Para a faixa de controle do LED (0 a 255)
  int brilho = map(potenciometroValor,0, 1023, 0, 255);
  
  // Enviar o valor do brilho calculado para o LED
  // Usando PWM
  
  analogWrite(11,brilho);
  }
}
