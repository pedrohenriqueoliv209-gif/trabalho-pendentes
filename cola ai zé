void setup()
{
 // define o pino 2 como entrada (botão)
 pinMode (2, INPUT); 
  // define o pino 13 como saida (LED) 
 pinMode (13, OUTPUT);
}
void loop ()
{
 // verificação se o pino 2 está recebendo um sinal high 
  
  if (digitalRead(2))
  {
   for (int i=0; i<=2; i++)
   { 	
   digitalWrite(13, HIGH);
     delay(1000);
   digitalWrite(13, LOW);
     delay(1000);
     
 }
  }
  else
 {
  digitalWrite(13, LOW);
  }
}
